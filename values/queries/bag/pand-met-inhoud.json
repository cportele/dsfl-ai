{
  "id": "pand-met-inhoud",
  "title": "Pand met verblijfsobjecten en adressen",
  "description": "Een pand met de verblijfsobjecten die erin liggen en hun hoofdadressen (nummeraanduidingen) en straten (openbare ruimten). Ook voor een gesloopt pand: dan de verblijfsobjecten die erin lagen, met status 'Verblijfsobject ingetrokken', hun laatste adres, gebruiksdoelen en oppervlakte. English: a building with its units (dwellings, shops, offices) and their addresses.",
  "parameters": {
    "pand": {
      "title": "pand",
      "description": "De identificatie van het pand (16 cijfers).",
      "type": "string",
      "pattern": "^[0-9]{4}10[0-9]{10}$"
    },
    "weglaten": {
      "title": "weglaten",
      "description": "Eigenschappen van de objecten die niet worden geleverd. Standaard de registratiegegevens (geconstateerd, documentdatum, documentnummer, voorkomenidentificatie, tijdstipRegistratie, eindRegistratie, tijdstipRegistratieLV, tijdstipEindRegistratieLV) en de niet-BAG-gegevens (gemeentecode, wijkcode, buurtcode, gemeentenaam, wijknaam, buurtnaam, grondoppervlakte, aantalVerblijfsobjecten, bouwjaarPand, statusPand); een lege lijst (weglaten=) levert alle eigenschappen. Een eigen lijst vervangt de standaardlijst: neem ook de standaardwaarden op die weggelaten moeten blijven. Standaard wel geleverd: objecttype. Ook elke andere eigenschap behalve identificatie is weg te laten (oorspronkelijkBouwjaar, status, beginGeldigheid, eindGeldigheid, voorgaandeVersie, volgendeVersie, gebruiksdoel, oppervlakte, heeftAlsHoofdadres, heeftAlsNevenadres, maaktDeelUitVan, huisnummer, huisletter, huisnummertoevoeging, postcode, typeAdresseerbaarObject, ligtAan, ligtIn, naam, verkorteNaam, type).",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "geconstateerd",
          "documentdatum",
          "documentnummer",
          "voorkomenidentificatie",
          "tijdstipRegistratie",
          "eindRegistratie",
          "tijdstipRegistratieLV",
          "tijdstipEindRegistratieLV",
          "gemeentecode",
          "wijkcode",
          "buurtcode",
          "gemeentenaam",
          "wijknaam",
          "buurtnaam",
          "grondoppervlakte",
          "aantalVerblijfsobjecten",
          "bouwjaarPand",
          "statusPand",
          "objecttype",
          "oorspronkelijkBouwjaar",
          "status",
          "beginGeldigheid",
          "eindGeldigheid",
          "voorgaandeVersie",
          "volgendeVersie",
          "gebruiksdoel",
          "oppervlakte",
          "heeftAlsHoofdadres",
          "heeftAlsNevenadres",
          "maaktDeelUitVan",
          "huisnummer",
          "huisletter",
          "huisnummertoevoeging",
          "postcode",
          "typeAdresseerbaarObject",
          "ligtAan",
          "ligtIn",
          "naam",
          "verkorteNaam",
          "type"
        ]
      },
      "default": [
        "geconstateerd",
        "documentdatum",
        "documentnummer",
        "voorkomenidentificatie",
        "tijdstipRegistratie",
        "eindRegistratie",
        "tijdstipRegistratieLV",
        "tijdstipEindRegistratieLV",
        "gemeentecode",
        "wijkcode",
        "buurtcode",
        "gemeentenaam",
        "wijknaam",
        "buurtnaam",
        "grondoppervlakte",
        "aantalVerblijfsobjecten",
        "bouwjaarPand",
        "statusPand"
      ]
    },
    "crs": {
      "title": "crs",
      "description": "Het coördinatenreferentiesysteem van de coördinaten in het resultaat: standaard WGS84-lengte/breedtegraad (CRS84), of het Rijksdriehoeksstelsel (EPSG:28992).",
      "type": "string",
      "enum": [
        "http://www.opengis.net/def/crs/OGC/1.3/CRS84",
        "http://www.opengis.net/def/crs/EPSG/0/28992"
      ],
      "default": "http://www.opengis.net/def/crs/OGC/1.3/CRS84"
    }
  },
  "filterCrs": "http://www.opengis.net/def/crs/OGC/1.3/CRS84",
  "crs": {
    "$parameter": {
      "crs": {
        "$ref": "#/parameters/crs"
      }
    }
  },
  "filter": {
    "op": "t_intersects",
    "args": [
      {
        "interval": [
          {
            "property": "beginGeldigheid"
          },
          {
            "property": "eindGeldigheid"
          }
        ]
      },
      {
        "timestamp": "now"
      }
    ]
  },
  "filterOperator": "AND",
  "excludeProperties": {
    "$parameter": {
      "weglaten": {
        "$ref": "#/parameters/weglaten"
      }
    }
  },
  "supportPaging": false,
  "deduplicate": true,
  "queries": [
    {
      "collections": [
        "pand"
      ],
      "filter": {
        "op": "=",
        "args": [
          {
            "property": "identificatie"
          },
          {
            "$parameter": {
              "pand": {
                "$ref": "#/parameters/pand"
              }
            }
          }
        ]
      },
      "resultSets": {
        "panden": {
          "values": "identificatie"
        }
      }
    },
    {
      "collections": [
        "verblijfsobject"
      ],
      "filter": {
        "op": "inResultSet",
        "args": [
          {
            "property": "maaktDeelUitVan"
          },
          "panden"
        ]
      },
      "resultSets": {
        "nummeraanduidingen": {
          "values": "heeftAlsHoofdadres"
        }
      }
    },
    {
      "collections": [
        "nummeraanduiding"
      ],
      "filter": {
        "op": "inResultSet",
        "args": [
          {
            "property": "identificatie"
          },
          "nummeraanduidingen"
        ]
      },
      "resultSets": {
        "straten": {
          "values": "ligtAan"
        }
      }
    },
    {
      "collections": [
        "openbareruimte"
      ],
      "filter": {
        "op": "inResultSet",
        "args": [
          {
            "property": "identificatie"
          },
          "straten"
        ]
      }
    }
  ]
}
